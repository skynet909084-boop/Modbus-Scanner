<Window x:Class="ModbusScanner.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Modbus Scanner 1.1.0" Height="820" Width="1380" MinHeight="650" MinWidth="1000"
 Background="#FF0B111B" Foreground="#FFE6F3FF" WindowStartupLocation="CenterScreen">
 
 <Window.Resources>
  <SolidColorBrush x:Key="BgBase" Color="#0B111B"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#121D2B"/>
  <SolidColorBrush x:Key="PanelRaisedBrush" Color="#19283A"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2A4358"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E6F3FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B3C5D5"/>
  <Style TargetType="{x:Type TextBlock}">
   <Setter Property="Foreground" Value="#FFDCEAF4"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <SolidColorBrush x:Key="AccentBrush" Color="#29E6D2"/>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Background" Value="#20394B"/>
   <Setter Property="Foreground" Value="#EAFBFF"/>
   <Setter Property="BorderBrush" Value="#3C6A7C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="3,2"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type Button}">
     <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#28546A"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#29E6D2"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#176D70"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Background" Value="#0A1420"/><Setter Property="Foreground" Value="#E6F3FF"/>
   <Setter Property="CaretBrush" Value="#29E6D2"/><Setter Property="BorderBrush" Value="#34546A"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,5"/>
   <Setter Property="Margin" Value="3,2"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="SelectionBrush" Value="#286F79"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#152333"/><Setter Property="Foreground" Value="#AFC4D5"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Background" Value="#F1F6FB"/><Setter Property="Foreground" Value="#172638"/>
   <Setter Property="BorderBrush" Value="#34546A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="3,2"/>
   <Setter Property="MinHeight" Value="29"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#586B7A"/><Setter Property="Background" Value="#DCE5EC"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Background" Value="#F1F6FB"/><Setter Property="Foreground" Value="#172638"/>
   <Setter Property="Padding" Value="8,5"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#245366"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176B72"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="#B9D1E2"/><Setter Property="Margin" Value="4,3"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="{x:Type TabControl}">
   <Setter Property="Background" Value="#121D2B"/><Setter Property="BorderBrush" Value="#2A4358"/>
   <Setter Property="Padding" Value="4"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
   <Setter Property="Foreground" Value="#A8C0D2"/><Setter Property="Background" Value="#172638"/>
   <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="2,2,2,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#29E6D2"/><Setter Property="Background" Value="#203C4D"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#254357"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type DataGrid}">
   <Setter Property="Background" Value="#0B1420"/><Setter Property="Foreground" Value="#DCECF7"/>
   <Setter Property="BorderBrush" Value="#2A4358"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="RowBackground" Value="#101D2B"/><Setter Property="AlternatingRowBackground" Value="#142333"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#203548"/>
   <Setter Property="VerticalGridLinesBrush" Value="#203548"/><Setter Property="CanUserResizeRows" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
  </Style>
  <Style TargetType="{x:Type DataGridColumnHeader}">
   <Setter Property="Background" Value="#20384B"/><Setter Property="Foreground" Value="#29E6D2"/>
   <Setter Property="BorderBrush" Value="#34546A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="9,8"/><Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style TargetType="{x:Type DataGridCell}">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,3"/><Setter Property="Foreground" Value="#FFDCECF7"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176B72"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type DataGridRow}">
   <Setter Property="MinHeight" Value="29"/><Setter Property="Foreground" Value="#FFDCECF7"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#174854"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B3447"/><Setter Property="Foreground" Value="#FFF4FAFF"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ListBox}">
   <Setter Property="Background" Value="#0B1420"/><Setter Property="Foreground" Value="#CDE1EF"/>
   <Setter Property="BorderBrush" Value="#2A4358"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Padding" Value="6,4"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176B72"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D3447"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>

 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#FF121D2B" BorderBrush="#FF2A4358" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left">
     <TextBlock Text="MODBUS SCANNER" FontSize="25" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FF29E6D2"/>
     <TextBlock Text="INDUSTRIAL COMMUNICATION SUITE   //   RTU · RS-485 · MODBUS TCP" Foreground="#FFB3C5D5" Margin="0,3,0,0"/>
     <TextBlock Text="Разработчик / Контакт: skynet909084@gmail.com" Foreground="#FFE6F3FF" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Не подключено" VerticalAlignment="Center" FontSize="14" Foreground="#FFF0B85B"/>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#FF202833" CornerRadius="8" Padding="8" Margin="0,0,0,8">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="Протокол" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="ProtocolBox" Width="115" SelectedIndex="0" SelectionChanged="ProtocolBox_SelectionChanged">
      <ComboBoxItem Content="RTU / COM"/><ComboBoxItem Content="TCP"/>
     </ComboBox>
     <TextBlock Text="COM" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="ComBox" Width="100"/>
     <Button Content="Обновить COM" Click="RefreshCom_Click"/>
      <Button Content="Сохранить профиль" Click="SaveProfile_Click"/>
      <Button Content="Загрузить профиль" Click="LoadProfile_Click"/>
     <TextBlock Text="IP / Host" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="HostBox" Width="150" Text="192.168.0.10"/>
     <TextBlock Text="Порт" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="PortBox" Width="65" Text="502"/>
     <TextBlock Text="Скорость" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="BaudBox" Width="100" SelectedIndex="5">
      <ComboBoxItem Content="1200"/><ComboBoxItem Content="2400"/><ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/>
     </ComboBox>
     <TextBlock Text="Parity" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="ParityBox" Width="75" SelectedIndex="0">
      <ComboBoxItem Content="None"/><ComboBoxItem Content="Even"/><ComboBoxItem Content="Odd"/>
     </ComboBox>
     <TextBlock Text="Data" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="DataBitsBox" Width="55" SelectedIndex="3">
      <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
     </ComboBox>
     <TextBlock Text="Stop" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="StopBitsBox" Width="55" SelectedIndex="0">
      <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
     </ComboBox>
     <TextBlock Text="Slave / Unit ID" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="UnitBox" Width="55" Text="1"/>
     <Button Content="Подключить / проверить" Background="#FF126D70" Foreground="White" Click="Connect_Click"/>
    </WrapPanel>
    <WrapPanel Margin="0,6,0,0">
     <TextBlock Text="Function" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="FunctionBox" Width="165" SelectedIndex="2">
      <ComboBoxItem Content="01 — Coils"/><ComboBoxItem Content="02 — Discrete Inputs"/><ComboBoxItem Content="03 — Holding Registers"/><ComboBoxItem Content="04 — Input Registers"/>
     </ComboBox>
     <TextBlock Text="Стартовый адрес" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="StartAddressBox" Width="85" Text="0"/>
     <TextBlock Text="Количество" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="QuantityBox" Width="75" Text="100"/>
     <Button Content="Читать диапазон" Click="ReadRange_Click"/>
     <Button Content="Автопоиск RTU" Background="#FF244B67" Foreground="White" Click="ScanRtu_Click"/>
     <Button Content="Сканировать регистры" Background="#FF315D83" Foreground="White" Click="ScanRegisters_Click"/>
     <Button Content="Остановить" Click="StopScan_Click"/>
     <Button Content="Экспорт CSV" Click="ExportCsv_Click"/>
     <TextBlock Text="Интерпретация" VerticalAlignment="Center" Margin="8,4,4,4"/>
     <ComboBox x:Name="ValueTypeBox" Width="155" SelectedIndex="0" SelectionChanged="ValueTypeBox_SelectionChanged">
      <ComboBoxItem Content="UInt16 (без знака)"/><ComboBoxItem Content="Int16 (со знаком)"/><ComboBoxItem Content="UInt32 ABCD"/><ComboBoxItem Content="Int32 ABCD"/><ComboBoxItem Content="Float32 ABCD"/><ComboBoxItem Content="UInt32 CDAB"/><ComboBoxItem Content="Int32 CDAB"/><ComboBoxItem Content="Float32 CDAB"/><ComboBoxItem Content="Float32 BADC"/><ComboBoxItem Content="Float32 DCBA"/>
     </ComboBox>
      <TextBlock Text="Период, мс" VerticalAlignment="Center" Margin="8,4,4,4"/>
      <TextBox x:Name="MonitorIntervalBox" Width="70" Text="1000"/>
      <Button Content="▶ Мониторинг" Click="StartMonitor_Click" Background="#FF147D78" Foreground="White"/>
      <Button Content="■ Стоп" Click="StopScan_Click"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2" Background="#FF202833" BorderBrush="#FF2A4358">
   <TabItem Header="Регистры">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,6">
      <TextBlock Text="Выбранный адрес" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="WriteAddressBox" Width="80" Text="0"/>
      <TextBlock Text="Новое значение" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="WriteValueBox" Width="100" Text="0" ToolTip="Значение 0–65535 в выбранном формате"/>
      <TextBlock Text="Формат" VerticalAlignment="Center" Margin="6,0,3,0"/>
      <ComboBox x:Name="WriteValueFormatBox" Width="75" SelectedIndex="0" SelectionChanged="WriteValueFormatBox_SelectionChanged" ToolTip="DEC — десятичный, HEX — шестнадцатеричный">
       <ComboBoxItem Content="DEC"/><ComboBoxItem Content="HEX"/>
      </ComboBox>
      <TextBlock Text="Бит" Margin="6,0,3,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="BitIndexBox" Width="50" SelectedIndex="0" ToolTip="Номер бита от 0 до 15">
       <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
       <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/>
       <ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/>
       <ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/>
      </ComboBox>
      <Button Content="Бит = 1" Click="SetBit_Click" ToolTip="Изменить подготовленное значение, без отправки устройству"/>
      <Button Content="Бит = 0" Click="ClearBit_Click" ToolTip="Изменить подготовленное значение, без отправки устройству"/>
      <TextBlock Text="32-бит" Margin="8,0,3,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="Write32TypeBox" Width="90" SelectedIndex="0">
       <ComboBoxItem Content="Float32"/><ComboBoxItem Content="Int32"/><ComboBoxItem Content="UInt32"/>
      </ComboBox>
      <ComboBox x:Name="Write32OrderBox" Width="76" SelectedIndex="0" ToolTip="Порядок байтов в двух регистрах">
       <ComboBoxItem Content="ABCD"/><ComboBoxItem Content="BADC"/><ComboBoxItem Content="CDAB"/><ComboBoxItem Content="DCBA"/>
      </ComboBox>
      <TextBox x:Name="Write32ValueBox" Width="115" Text="0" ToolTip="32-битное значение, десятичный формат"/>
      <Button x:Name="SimulatorButton" Content="Запустить TCP симулятор" Click="ToggleSimulator_Click" ToolTip="Локальный тестовый сервер 127.0.0.1:1502"/>
      <Button Content="Экспорт карты JSON" Click="ExportRegisterMap_Click" ToolTip="Сохранить описания регистров в отдельную карту"/>
      <Button Content="Импорт карты JSON" Click="ImportRegisterMap_Click" ToolTip="Загрузить карту регистров без изменения параметров соединения"/>
      <Button Content="Записать 32-бит (FC16)" Click="Write32_Click" ToolTip="Запись двух последовательных holding-регистров с подтверждением"/>
      <Button Content="Записать регистр (FC06)" Background="#FF7A5125" Foreground="White" Click="WriteRegister_Click"/>
      <Button Content="Записать несколько (FC16)" Background="#FF9C6124" Foreground="White" Click="WriteMultiple_Click"/>
      <Button Content="Записать Coil (FC05)" Background="#FF9C6124" Foreground="White" Click="WriteCoil_Click"/>
      <Button Content="Повторно прочитать выбранный" Click="RefreshSelected_Click"/>
      <CheckBox x:Name="EnableWritesBox" Content="Разрешить запись" IsChecked="False"/>
     </WrapPanel>
     <DataGrid x:Name="RegistersGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
      Background="#FF0B1420" Foreground="#FFE7EDF3" RowBackground="#FF101D2B" AlternatingRowBackground="#FF142333"
      BorderBrush="#FF34414E" GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="RegistersGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="FC" Binding="{Binding Function}" IsReadOnly="True" Width="45"/><DataGridTextColumn Header="Address (0-based)" Binding="{Binding Address}" IsReadOnly="True" Width="150"/>
       <DataGridTextColumn Header="Value (DEC)" Binding="{Binding RawValue}" IsReadOnly="True" Width="120"/>
       <DataGridTextColumn Header="К записи FC16" Binding="{Binding PendingValue, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Int16" Binding="{Binding SignedValue}" IsReadOnly="True" Width="85"/><DataGridTextColumn Header="HEX" Binding="{Binding HexValue}" IsReadOnly="True" Width="100"/>
       <DataGridTextColumn Header="Типизированное значение" Binding="{Binding DisplayValue}" IsReadOnly="True" Width="210"/>
       <DataGridTextColumn Header="Float ABCD" Binding="{Binding FloatABCD}" IsReadOnly="True" Width="115"/>
       <DataGridTextColumn Header="Float BADC" Binding="{Binding FloatBADC}" IsReadOnly="True" Width="115"/>
       <DataGridTextColumn Header="Float CDAB" Binding="{Binding FloatCDAB}" IsReadOnly="True" Width="115"/>
       <DataGridTextColumn Header="Float DCBA" Binding="{Binding FloatDCBA}" IsReadOnly="True" Width="115"/>
       <DataGridTextColumn Header="BIN" Binding="{Binding BinaryValue}" IsReadOnly="True" Width="180"/>
       <DataGridTextColumn Header="Интерпретация / примечание" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="Ед." Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
       <DataGridTextColumn Header="Множитель" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
       <DataGridTextColumn Header="Смещение" Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
       <DataGridTextColumn Header="Пересчёт" Binding="{Binding ScaledValue}" IsReadOnly="True" Width="90"/>
       <DataGridTextColumn Header="Качество" Binding="{Binding Quality}" IsReadOnly="True" Width="110">
        <DataGridTextColumn.CellStyle>
         <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding Quality}" Value="OK"><Setter Property="Foreground" Value="#FF29E6A0"/></DataTrigger>
           <DataTrigger Binding="{Binding Quality}" Value="Ошибка"><Setter Property="Foreground" Value="#FFFF7373"/></DataTrigger>
           <DataTrigger Binding="{Binding Quality}" Value="—"><Setter Property="Foreground" Value="#FFB3C5D5"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </DataGridTextColumn.CellStyle>
       </DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Поиск TCP">
    <Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Поиск Modbus TCP-устройств в локальной сети" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="IP от" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="TcpScanStartBox" Width="130" Text="192.168.0.1"/>
      <TextBlock Text="IP до" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="TcpScanEndBox" Width="130" Text="192.168.0.254"/>
      <TextBlock Text="Порты через запятую" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="TcpScanPortBox" Width="140" Text="502"/>
      <TextBlock Text="Тайм-аут, мс" VerticalAlignment="Center" Margin="4"/>
      <TextBox x:Name="TcpScanTimeoutBox" Width="70" Text="400"/>
      <Button Content="Найти узлы" Click="ScanTcpNetwork_Click" Background="#FF147D78" Foreground="White"/>
      <Button Content="Остановить поиск" Click="StopScan_Click"/>
     </WrapPanel>
     <ListBox x:Name="TcpScanResultsList" Grid.Row="2" Background="#FF151C24" Foreground="#FFE7EDF3" BorderBrush="#FF34414E" FontFamily="Consolas" SelectionChanged="TcpScanResultsList_SelectionChanged"/>
    </Grid>
   </TabItem>
   <TabItem Header="Снимки / изменения">
    <DockPanel Margin="10">
     <WrapPanel DockPanel.Dock="Top"><Button Content="Сделать снимок" Click="Snapshot_Click"/><Button Content="Сохранить снимок" Click="SaveSnapshot_Click"/><Button Content="Загрузить и сравнить" Click="LoadSnapshot_Click"/></WrapPanel>
     <DataGrid x:Name="SnapshotGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="График / история">
    <DockPanel Margin="10">
     <WrapPanel DockPanel.Dock="Top"><TextBlock Text="Адреса через запятую (до 4, текущая FC)" VerticalAlignment="Center"/><TextBox x:Name="TrendAddressBox" Width="170" Text="0" TextChanged="TrendChanged"/><Button Content="История CSV" Click="ExportHistory_Click"/><Button Content="Очистить историю" Click="ClearHistory_Click"/><TextBlock Text="До 100 000 точек; график последних 1000. Значение = Raw × множитель + смещение." TextWrapping="Wrap"/></WrapPanel>
     <Canvas x:Name="TrendCanvas" Background="#0A1420" ClipToBounds="True" SizeChanged="TrendResized"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Автопоиск">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="12">
      <TextBlock Text="Автопоиск RTU" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
      <WrapPanel><TextBlock Text="Скорости через запятую"/><TextBox x:Name="RtuBaudsBox" Text="9600,19200,38400" Width="240"/><TextBlock Text="Чётность"/><TextBox x:Name="RtuParitiesBox" Text="None,Even,Odd" Width="180"/></WrapPanel>
      <WrapPanel><TextBlock Text="ID от / до"/><TextBox x:Name="RtuUnitFromBox" Text="1" Width="60"/><TextBox x:Name="RtuUnitToBox" Text="247" Width="60"/><CheckBox x:Name="RtuResumeBox" Content="Продолжить остановленный поиск (в текущем сеансе)" IsChecked="True"/></WrapPanel>
      <TextBlock TextWrapping="Wrap" Text="Поиск перебирает выбранный COM-порт, скорости, формат кадра и Slave ID. На каждый вариант отправляется выбранный запрос FC03/FC04 по стартовому адресу из панели. Биты данных и стоп-биты берутся из панели подключения. Валидный CRC и правильный ответ подтверждают найденную комбинацию. Это может занять время; неизвестная карта регистров не гарантирует, что каждый адрес реализован."/>
      <ListBox x:Name="RtuFoundList" Height="180" SelectionChanged="RtuFound_Selected"/><TextBlock Text="Выберите результат после остановки поиска, чтобы применить параметры. Результаты поиска появляются в журнале. Для скорости используйте ограниченный диапазон Slave ID и отметьте только реальные скорости, поддерживаемые преобразователем и контроллером." Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#FF202833" CornerRadius="8" Padding="8" Margin="0,8,0,0">
   <DockPanel>
